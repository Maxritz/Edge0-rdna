+// =============================== ROCmFPX (Edge0 private)
+// Low-bit weight formats from charlie12345/ROCmFPX. Block = QK_ROCMFPX (32) values.
+// Layouts and bit order match the reference; validated by round-trip.
+
+static inline float ggml_rocmfpx_fp4_code(uint8_t q) {
+    q &= 0x0F;
+    const int m3 = q & 0x07;
+    const int mag = (m3 <= 4) ? m3 : 2*m3 - 4;
+    return (float)((q & 0x08) ? -mag : mag);
+}
+
+static inline float ggml_rocmfpx_fp3_code(uint8_t c) {
+    static const int mag[4] = {0, 1, 2, 4};
+    const int v = mag[c & 3];
+    return (float)((c & 4) ? -v : v);
+}
+
+static inline float ggml_rocmfpx_fp6_code(uint8_t c) {
+    const int mag = c & 31;
+    return (float)((c & 32) ? -(mag == 0 ? 32 : mag) : mag);
+}
+
+static inline float ggml_rocmfpx_fp2_code(uint8_t c) {
+    static const float cb[4] = {-4.0f, -1.0f, 1.0f, 4.0f};
+    return cb[c & 3];
+}
+
+static inline void ggml_rocmfpx_fp3_unpack8(const uint8_t * s, uint8_t * c) {
+    c[0] = s[0] & 7;                              c[1] = (s[0] >> 3) & 7;
+    c[2] = ((s[0] >> 6) & 3) | ((s[1] & 1) << 2); c[3] = (s[1] >> 1) & 7;
+    c[4] = (s[1] >> 4) & 7;                       c[5] = ((s[1] >> 7) & 1) | ((s[2] & 3) << 1);
+    c[6] = (s[2] >> 2) & 7;                       c[7] = (s[2] >> 5) & 7;
+}
+
+static inline void ggml_rocmfpx_fp3_pack8(uint8_t * d, const uint8_t * c) {
+    d[0] = (c[0] & 7) | ((c[1] & 7) << 3) | ((c[2] & 3) << 6);
+    d[1] = ((c[2] >> 2) & 1) | ((c[3] & 7) << 1) | ((c[4] & 7) << 4) | ((c[5] & 1) << 7);
+    d[2] = ((c[5] >> 1) & 3) | ((c[6] & 7) << 2) | ((c[7] & 7) << 5);
+}
+
+static inline void ggml_rocmfpx_fp6_unpack4(const uint8_t * s, uint8_t * c) {
+    c[0] = s[0] & 0x3f;
+    c[1] = ((s[0] >> 6) & 0x03) | ((s[1] & 0x0f) << 2);
+    c[2] = ((s[1] >> 4) & 0x0f) | ((s[2] & 0x03) << 4);
+    c[3] = (s[2] >> 2) & 0x3f;
+}
+
+static inline void ggml_rocmfpx_fp6_pack4(uint8_t * d, const uint8_t * c) {
+    d[0] = (c[0] & 0x3f) | ((c[1] & 0x03) << 6);
+    d[1] = ((c[1] >> 2) & 0x0f) | ((c[2] & 0x0f) << 4);
+    d[2] = ((c[2] >> 4) & 0x03) | ((c[3] & 0x3f) << 2);
+}
