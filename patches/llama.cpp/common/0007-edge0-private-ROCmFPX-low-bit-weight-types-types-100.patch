+__device__ __forceinline__ int rocmfp3_val(const int code) {
+    const int mag = (code & 3) == 0 ? 0 : (code & 3) == 1 ? 1 : (code & 3) == 2 ? 2 : 4;
+    return (code & 4) ? -mag : mag;
+}
