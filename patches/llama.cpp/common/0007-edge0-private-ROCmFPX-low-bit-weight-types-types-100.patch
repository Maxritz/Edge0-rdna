+void quantize_row_rocmfp2_ref(const float * GGML_RESTRICT x, block_rocmfp2 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    static const float cb[4] = {-4.0f, -1.0f, 1.0f, 4.0f};
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        for (int half = 0; half < 2; ++half) {
+            float maxa = 0.0f;
+            for (int j = 0; j < 16; ++j) { maxa = MAX(maxa, fabsf(xb[half*16 + j])); }
+            const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 4.0f : 0.0f);
+            y[i].d[half] = e;
+            const float d = ggml_ue4m3_to_fp32(e);
+            const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+            for (int j = 0; j < 16; ++j) {
+                const float v = xb[half*16 + j] * inv;
+                uint8_t bi = 0;
+                float bd = fabsf(cb[0] - v);
+                for (int c = 1; c < 4; ++c) { const float dd = fabsf(cb[c] - v); if (dd < bd) { bd = dd; bi = (uint8_t) c; } }
+                y[i].qs[j/4] |= bi << (2*(j%4));
+            }
+        }
+    }
