+            ggml_rocmfpx_fp6_unpack4(&x[i].qs[g*3], &codes[g*4]);
+        }
+        const float d0 = ggml_ue4m3_to_fp32(x[i].d[0]);
+        const float d1 = ggml_ue4m3_to_fp32(x[i].d[1]);
+        for (int j = 0; j < 16; ++j) {
+            y[i*qk + j     ] = ggml_rocmfpx_fp6_code(codes[j])      * d0;
+            y[i*qk + j + 16] = ggml_rocmfpx_fp6_code(codes[j + 16]) * d1;
+        }
+    }
+}
+
+void dequantize_row_rocmfp8(const block_rocmfp8 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float d = ggml_ue4m3_to_fp32(x[i].d);
+        for (int j = 0; j < qk; ++j) {
+            y[i*qk + j] = (float) x[i].qs[j] * d;
+        }
+    }
+}
+
+void dequantize_row_rocmfp3(const block_rocmfp3 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        uint8_t codes[32];
+        ggml_rocmfpx_fp3_unpack8(&x[i].qs[0], &codes[0]);  ggml_rocmfpx_fp3_unpack8(&x[i].qs[3], &codes[8]);
+        ggml_rocmfpx_fp3_unpack8(&x[i].qs[6], &codes[16]); ggml_rocmfpx_fp3_unpack8(&x[i].qs[9], &codes[24]);
+        const float d0 = ggml_ue4m3_to_fp32(x[i].d[0]);
+        const float d1 = ggml_ue4m3_to_fp32(x[i].d[1]);
+        for (int j = 0; j < 16; ++j) {
+            y[i*qk + j     ] = ggml_rocmfpx_fp3_code(codes[j])      * d0;
+            y[i*qk + j + 16] = ggml_rocmfpx_fp3_code(codes[j + 16]) * d1;
+        }
+    }
+}
+
+void dequantize_row_rocmfp2(const block_rocmfp2 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float d0 = ggml_ue4m3_to_fp32(x[i].d[0]);
+        const float d1 = ggml_ue4m3_to_fp32(x[i].d[1]);
+        for (int ib = 0; ib < 8; ++ib) {
+            const uint8_t byte = x[i].qs[ib];
+            for (int j = 0; j < 4; ++j) {
+                const int idx = ib*4 + j;
+                const float v = ggml_rocmfpx_fp2_code((byte >> (j*2)) & 0x3);
+                y[i*qk + idx] = v * (idx < 16 ? d0 : d1);
+            }
+        }
+    }
+}
+
+static uint8_t ggml_rocmfpx_fp4_quant_code(float x, float inv) {
+    const float v = roundf(x * inv);
+    uint8_t best = 0;
+    float bd = fabsf(ggml_rocmfpx_fp4_code(0) - v);
+    for (int q = 1; q < 16; ++q) {
+        const float d = fabsf(ggml_rocmfpx_fp4_code((uint8_t) q) - v);
+        if (d < bd) { bd = d; best = (uint8_t) q; }
+    }
+    return best;
+}
+
+static uint8_t ggml_rocmfpx_fp3_quant_code(float x, float inv) {
+    const float a = fabsf(x * inv);
+    const int mag = a <= 0.5f ? 0 : a <= 1.5f ? 1 : a <= 3.0f ? 2 : 3;
+    if (mag == 0) { return 0; }
+    return (uint8_t)((x < 0.0f ? 4 : 0) | mag);
+}
+
+static uint8_t ggml_rocmfpx_fp6_quant_code(float x, float inv) {
+    int q = (int) lroundf(x * inv);
+    if (q > 31) { q = 31; } else if (q < -32) { q = -32; }
+    if (q == 0) { return 0; }
+    if (q < 0)  { return (uint8_t)(32u | ((uint8_t)(-q) & 31)); }
+    return (uint8_t) q;
+}
+
+void quantize_row_rocmfp4_ref(const float * GGML_RESTRICT x, block_rocmfp4 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        for (int half = 0; half < 2; ++half) {
+            float maxa = 0.0f;
+            for (int j = 0; j < 16; ++j) { maxa = MAX(maxa, fabsf(xb[half*16 + j])); }
+            const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 10.0f : 0.0f);
+            y[i].d[half] = e;
+            const float d = ggml_ue4m3_to_fp32(e);
+            const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+            for (int j = 0; j < 16; ++j) {
+                y[i].qs[j] |= ggml_rocmfpx_fp4_quant_code(xb[half*16 + j], inv) << (4*half);
+            }
+        }
+    }
+}
+
+void quantize_row_rocmfp4_fast_ref(const float * GGML_RESTRICT x, block_rocmfp4_fast * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        float maxa = 0.0f;
+        for (int j = 0; j < qk; ++j) { maxa = MAX(maxa, fabsf(xb[j])); }
+        const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 10.0f : 0.0f);
+        y[i].d = e;
+        const float d = ggml_ue4m3_to_fp32(e);
+        const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+        for (int j = 0; j < 16; ++j) {
+            y[i].qs[j] = ggml_rocmfpx_fp4_quant_code(xb[j], inv) | (ggml_rocmfpx_fp4_quant_code(xb[j + 16], inv) << 4);
+        }
+    }
+}
+
+void quantize_row_rocmfp6_ref(const float * GGML_RESTRICT x, block_rocmfp6 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        uint8_t codes[32];
+        for (int half = 0; half < 2; ++half) {
+            float maxa = 0.0f;
+            for (int j = 0; j < 16; ++j) { maxa = MAX(maxa, fabsf(xb[half*16 + j])); }
+            const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 31.0f : 0.0f);
+            y[i].d[half] = e;
+            const float d = ggml_ue4m3_to_fp32(e);
+            const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+            for (int j = 0; j < 16; ++j) { codes[half*16 + j] = ggml_rocmfpx_fp6_quant_code(xb[half*16 + j], inv); }
+        }
+        for (int g = 0; g < 8; ++g) { ggml_rocmfpx_fp6_pack4(&y[i].qs[g*3], &codes[g*4]); }
+    }
+}
+
+void quantize_row_rocmfp8_ref(const float * GGML_RESTRICT x, block_rocmfp8 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        float maxa = 0.0f;
+        for (int j = 0; j < qk; ++j) { maxa = MAX(maxa, fabsf(xb[j])); }
+        const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 127.0f : 0.0f);
+        y[i].d = e;
+        const float d = ggml_ue4m3_to_fp32(e);
+        const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+        for (int j = 0; j < qk; ++j) {
+            int q = (int) lroundf(xb[j] * inv);
+            if (q > 127) { q = 127; } else if (q < -127) { q = -127; }
+            y[i].qs[j] = (int8_t) q;
+        }
+    }
+}
+
+void quantize_row_rocmfp3_ref(const float * GGML_RESTRICT x, block_rocmfp3 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        for (int half = 0; half < 2; ++half) {
+            float maxa = 0.0f;
+            for (int j = 0; j < 16; ++j) { maxa = MAX(maxa, fabsf(xb[half*16 + j])); }
+            const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 4.0f : 0.0f);
+            y[i].d[half] = e;
+            const float d = ggml_ue4m3_to_fp32(e);
+            const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+            uint8_t codes[16];
+            for (int j = 0; j < 16; ++j) { codes[j] = ggml_rocmfpx_fp3_quant_code(xb[half*16 + j], inv); }
+            ggml_rocmfpx_fp3_pack8(&y[i].qs[half*6],     &codes[0]);
+            ggml_rocmfpx_fp3_pack8(&y[i].qs[half*6 + 3], &codes[8]);
+        }
+    }
+}
+
+void quantize_row_rocmfp2_ref(const float * GGML_RESTRICT x, block_rocmfp2 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    static const float cb[4] = {-4.0f, -1.0f, 1.0f, 4.0f};
+    for (int i = 0; i < nb; i++) {
+        const float * xb = x + i*qk;
+        for (int half = 0; half < 2; ++half) {
+            float maxa = 0.0f;
+            for (int j = 0; j < 16; ++j) { maxa = MAX(maxa, fabsf(xb[half*16 + j])); }
+            const uint8_t e = ggml_rocmfpx_ue4m3_nearest(maxa > 0.0f ? maxa / 4.0f : 0.0f);
+            y[i].d[half] = e;
+            const float d = ggml_ue4m3_to_fp32(e);
+            const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+            for (int j = 0; j < 16; ++j) {
+                const float v = xb[half*16 + j] * inv;
+                uint8_t bi = 0;
+                float bd = fabsf(cb[0] - v);
+                for (int c = 1; c < 4; ++c) { const float dd = fabsf(cb[c] - v); if (dd < bd) { bd = dd; bi = (uint8_t) c; } }
+                y[i].qs[j/4] |= bi << (2*(j%4));
+            }
+        }
+    }
+}
+
+// =============================== TurboQuant KV (Edge0 private)
+// FWHT-rotated, 128-value blocks; a per-chunk L2 norm in f16 plus 3/4-bit codebook
+// codes. Foundation (types + quant/dequant); flashing the attention path is staged.
+static void ggml_fwht_f32(float * x, int n) {
+    for (int h = 1; h < n; h <<= 1) {
+        for (int i = 0; i < n; i += 2*h) {
+            for (int j = i; j < i + h; ++j) {
+                const float a = x[j], b = x[j + h];
+                x[j] = a + b;
+                x[j + h] = a - b;
+            }
+        }
+    }
+    const float s = 1.0f / sqrtf((float) n);
+    for (int i = 0; i < n; ++i) { x[i] *= s; }
+}
+
+static const float ggml_turbo3_cb[8] = {
+    -0.1883972972f, -0.1181399059f, -0.0665857641f, -0.0216044751f,
+     0.0216041461f,  0.0665854520f,  0.1181396281f,  0.1883970748f,
+};
+static const float ggml_turbo4_cb[16] = {
+    -0.2376389871f, -0.1808080141f, -0.1417777640f, -0.1102646123f,
+    -0.0828112376f, -0.0577640422f, -0.0341540905f, -0.0113168380f,
+     0.0112761586f,  0.0341139667f,  0.0577250301f,  0.0827738972f,
+     0.1102295202f,  0.1417455465f,  0.1807794468f,  0.2376153882f,
+};
+
+static uint8_t ggml_turbo_nearest(const float * cb, int n, float v) {
+    uint8_t best = 0; float bd = fabsf(cb[0] - v);
+    for (int i = 1; i < n; ++i) { const float d = fabsf(cb[i] - v); if (d < bd) { bd = d; best = (uint8_t) i; } }
+    return best;
+}
+
+void dequantize_row_turbo3(const block_turbo3 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int nb = k / QK_TURBO;
+    float t[QK_TURBO];
+    for (int i = 0; i < nb; i++) {
+        for (int c = 0; c < 128; ++c) {
+            const int bit = c * 3, by = bit >> 3, sh = bit & 7;
+            int idx = x[i].qs[by] >> sh;
+            if (sh > 5 && by + 1 < 48) { idx |= (x[i].qs[by + 1] << (8 - sh)); }
+            t[c] = ggml_turbo3_cb[idx & 7];
+        }
+        ggml_fwht_f32(t, QK_TURBO);
+        const float nrm = GGML_FP16_TO_FP32(x[i].norm);
+        for (int c = 0; c < 128; ++c) { y[i*QK_TURBO + c] = t[c] * nrm; }
+    }
+}
+
+void dequantize_row_turbo4(const block_turbo4 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int nb = k / QK_TURBO;
+    float t[QK_TURBO];
+    for (int i = 0; i < nb; i++) {
+        for (int c = 0; c < 128; ++c) {
+            const uint8_t byte = x[i].qs[c >> 1];
+            const int idx = (c & 1) ? (byte >> 4) : (byte & 0x0f);
+            t[c] = ggml_turbo4_cb[idx];
+        }
+        ggml_fwht_f32(t, QK_TURBO);
+        const float nrm = GGML_FP16_TO_FP32(x[i].norm);
+        for (int c = 0; c < 128; ++c) { y[i*QK_TURBO + c] = t[c] * nrm; }
+    }
+}
+
+void quantize_row_turbo3_ref(const float * GGML_RESTRICT x, block_turbo3 * GGML_RESTRICT y, int64_t k) {
+    const int nb = k / QK_TURBO;
+    for (int i = 0; i < nb; i++) {
+        const float * xs = x + i*QK_TURBO;
+        float nrm = 0.0f; for (int c = 0; c < QK_TURBO; ++c) { nrm += xs[c]*xs[c]; }
+        nrm = sqrtf(nrm);
+        y[i].norm = GGML_FP32_TO_FP16(nrm);
+        const float inv = nrm > 1e-10f ? 1.0f / nrm : 0.0f;
+        float t[QK_TURBO];
+        for (int c = 0; c < QK_TURBO; ++c) { t[c] = xs[c] * inv; }
+        ggml_fwht_f32(t, QK_TURBO);
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        for (int c = 0; c < QK_TURBO; ++c) {
+            const int idx = ggml_turbo_nearest(ggml_turbo3_cb, 8, t[c]);
+            const int bit = c*3, by = bit >> 3, sh = bit & 7;
+            y[i].qs[by] |= (uint8_t)(idx << sh);
+            if (sh > 5 && by + 1 < 48) { y[i].qs[by + 1] |= (uint8_t)(idx >> (8 - sh)); }
+        }
+    }
+}
+
+void quantize_row_turbo4_ref(const float * GGML_RESTRICT x, block_turbo4 * GGML_RESTRICT y, int64_t k) {
+    const int nb = k / QK_TURBO;
+    for (int i = 0; i < nb; i++) {
+        const float * xs = x + i*QK_TURBO;
+        float nrm = 0.0f; for (int c = 0; c < QK_TURBO; ++c) { nrm += xs[c]*xs[c]; }
+        nrm = sqrtf(nrm);
+        y[i].norm = GGML_FP32_TO_FP16(nrm);
+        const float inv = nrm > 1e-10f ? 1.0f / nrm : 0.0f;
+        float t[QK_TURBO];
+        for (int c = 0; c < QK_TURBO; ++c) { t[c] = xs[c] * inv; }
+        ggml_fwht_f32(t, QK_TURBO);
+        memset(y[i].qs, 0, sizeof(y[i].qs));
+        for (int c = 0; c < QK_TURBO; ++c) {
+            const int idx = ggml_turbo_nearest(ggml_turbo4_cb, 16, t[c]);
+            if (c & 1) { y[i].qs[c >> 1] |= (uint8_t)(idx << 4); } else { y[i].qs[c >> 1] |= (uint8_t) idx; }
+        }
+    }
+}
