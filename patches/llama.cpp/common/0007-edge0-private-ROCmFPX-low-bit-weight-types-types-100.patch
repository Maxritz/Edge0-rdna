+        const float inv = d > 0.0f ? 1.0f / d : 0.0f;
+        for (int j = 0; j < qk; ++j) {
+            int q = (int) lroundf(xb[j] * inv);
+            if (q > 127) { q = 127; } else if (q < -127) { q = -127; }
+            y[i].qs[j] = (int8_t) q;
+        }
+    }
