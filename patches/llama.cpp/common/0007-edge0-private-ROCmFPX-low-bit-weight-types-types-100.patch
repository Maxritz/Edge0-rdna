diff --git a/ggml/src/ggml-cuda/convert.cu b/ggml/src/ggml-cuda/convert.cu
index 0619f4760..ffa3405a5 100644
--- a/ggml/src/ggml-cuda/convert.cu
+++ b/ggml/src/ggml-cuda/convert.cu
@@ -413,6 +413,133 @@ static void dequantize_row_nvfp4_cuda(
     const int nb = k / QK_NVFP4;
     dequantize_block_nvfp4<<<nb, 32, 0, stream>>>(vx, y, k);
 }
+
+// Edge0 (private): ROCmFPX weight-format dequant. QK_ROCMFPX = 32 values per block.
+static __device__ __forceinline__ float rocmfpx_fp4_code(uint8_t q) {
+    q &= 0x0F;
+    const int m3 = q & 0x07;
+    const int mag = (m3 <= 4) ? m3 : 2 * m3 - 4;
+    return (float)((q & 0x08) ? -mag : mag);
+}
+
+static __device__ __forceinline__ float rocmfpx_fp3_code(uint8_t c) {
+    const int i = c & 3;
+    const int mag = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : 4;
+    return (float)((c & 4) ? -mag : mag);
+}
+
+static __device__ __forceinline__ float rocmfpx_fp6_code(uint8_t c) {
+    const int mag = c & 31;
+    return (float)((c & 32) ? -(mag == 0 ? 32 : mag) : mag);
+}
+
+static __device__ __forceinline__ float rocmfpx_fp2_code(uint8_t c) {
+    const uint8_t i = c & 3;
+    return i == 0 ? -4.0f : i == 1 ? -1.0f : i == 2 ? 1.0f : 4.0f;
+}
+
+static __device__ __forceinline__ void rocmfpx_fp3_unpack8(const uint8_t * s, uint8_t * c) {
+    c[0] = s[0] & 7;                              c[1] = (s[0] >> 3) & 7;
+    c[2] = ((s[0] >> 6) & 3) | ((s[1] & 1) << 2); c[3] = (s[1] >> 1) & 7;
+    c[4] = (s[1] >> 4) & 7;                       c[5] = ((s[1] >> 7) & 1) | ((s[2] & 3) << 1);
+    c[6] = (s[2] >> 2) & 7;                       c[7] = (s[2] >> 5) & 7;
+}
+
+static __device__ __forceinline__ void rocmfpx_fp6_unpack4(const uint8_t * s, uint8_t * c) {
+    c[0] = s[0] & 0x3f;
+    c[1] = ((s[0] >> 6) & 0x03) | ((s[1] & 0x0f) << 2);
+    c[2] = ((s[1] >> 4) & 0x0f) | ((s[2] & 0x03) << 4);
+    c[3] = (s[2] >> 2) & 0x3f;
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp4(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp4 * x = (const block_rocmfp4 *) vx;
+    const int half = t / 16, j = t % 16;
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d[half]);
+    const uint8_t code = half == 0 ? (x[i].qs[j] & 0x0F) : (x[i].qs[j] >> 4);
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>(rocmfpx_fp4_code(code) * d);
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp4_fast(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp4_fast * x = (const block_rocmfp4_fast *) vx;
+    const int half = t / 16, j = t % 16;
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d);
+    const uint8_t code = half == 0 ? (x[i].qs[j] & 0x0F) : (x[i].qs[j] >> 4);
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>(rocmfpx_fp4_code(code) * d);
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp6(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp6 * x = (const block_rocmfp6 *) vx;
+    uint8_t c[4];
+    rocmfpx_fp6_unpack4(&x[i].qs[(t / 4) * 3], c);
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d[t / 16]);
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>(rocmfpx_fp6_code(c[t % 4]) * d);
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp8(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp8 * x = (const block_rocmfp8 *) vx;
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d);
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>((float) x[i].qs[t] * d);
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp3(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp3 * x = (const block_rocmfp3 *) vx;
+    uint8_t c[8];
+    rocmfpx_fp3_unpack8(&x[i].qs[(t / 8) * 3], c);
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d[t / 16]);
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>(rocmfpx_fp3_code(c[t % 8]) * d);
+}
+
+template<typename dst_t>
+static __global__ void dequantize_block_rocmfp2(const void * __restrict__ vx, dst_t * __restrict__ yy) {
+    const int64_t i = blockIdx.x;
+    const int t = threadIdx.x;
+    const block_rocmfp2 * x = (const block_rocmfp2 *) vx;
+    const float d = ggml_cuda_ue4m3_to_fp32(x[i].d[t / 16]);
+    const uint8_t code = (x[i].qs[t / 4] >> (2 * (t % 4))) & 0x3;
+    yy[i*QK_ROCMFPX + t] = ggml_cuda_cast<dst_t>(rocmfpx_fp2_code(code) * d);
+}
+
+template<typename dst_t>
+static void dequantize_row_rocmfp4_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp4<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
+template<typename dst_t>
+static void dequantize_row_rocmfp4_fast_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp4_fast<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
+template<typename dst_t>
+static void dequantize_row_rocmfp6_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp6<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
+template<typename dst_t>
+static void dequantize_row_rocmfp8_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp8<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
+template<typename dst_t>
+static void dequantize_row_rocmfp3_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp3<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
+template<typename dst_t>
+static void dequantize_row_rocmfp2_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
+    dequantize_block_rocmfp2<<<k / QK_ROCMFPX, QK_ROCMFPX, 0, stream>>>(vx, y);
+}
