+static uint8_t ggml_rocmfpx_ue4m3_nearest(float target) {
+    if (!(target > 0.0f) || !isfinite(target)) {
+        return 0;
+    }
+    uint8_t best = 1;
+    float bd = fabsf(ggml_ue4m3_to_fp32(1) - target);
+    for (int e = 1; e <= 0x7e; ++e) {
+        const float d = fabsf(ggml_ue4m3_to_fp32((uint8_t) e) - target);
+        if (d < bd) {
+            bd = d;
+            best = (uint8_t) e;
+        }
+    }
+    return best;
+}
