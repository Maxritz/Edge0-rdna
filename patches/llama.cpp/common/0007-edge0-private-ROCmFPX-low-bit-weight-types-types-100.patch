diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 224bdef92..82d194c5f 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -430,7 +430,21 @@ extern "C" {
         GGML_TYPE_NVFP4   = 40, // NVFP4 (4 blocks, E4M3 scale)
         GGML_TYPE_Q1_0    = 41,
         GGML_TYPE_Q2_0    = 42,
-        GGML_TYPE_COUNT   = 43,
+        // Edge0 (private): ROCmFPX low-bit weight formats. GGUF files store these at
+        // 100..107 (fp4, fp4_fast, fp6, fp8, fp3, turbo3, turbo4, fp2); gguf.cpp remaps
+        // the fp weight types to these compact ids. turbo3/turbo4 are KV-cache formats
+        // and are not handled here.
+        GGML_TYPE_ROCMFP4      = 43,
+        GGML_TYPE_ROCMFP4_FAST = 44,
+        GGML_TYPE_ROCMFP6      = 45,
+        GGML_TYPE_ROCMFP8      = 46,
+        GGML_TYPE_ROCMFP3      = 47,
+        GGML_TYPE_ROCMFP2      = 48,
+        // Edge0 (private): TurboQuant KV-cache formats (FWHT-rotated, 128-value blocks).
+        // Not weight types; intended for -ctk/-ctv. Foundation only (see ggml-quants.c).
+        GGML_TYPE_TURBO3       = 49,
+        GGML_TYPE_TURBO4       = 50,
+        GGML_TYPE_COUNT   = 51,
     };
 
     // [TAG_GGML_PREC]
diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index 1dbbe326d..af96998ad 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -218,6 +218,55 @@ typedef struct {
 } block_mxfp4;
 static_assert(sizeof(block_mxfp4) == sizeof(uint8_t) + QK_MXFP4/2, "wrong mxfp4 block size/padding");
 
+// Edge0 (private): ROCmFPX weight-format blocks. Each is QK_ROCMFPX=32 values. Layouts
+// captured from charlie12345/ROCmFPX; verified against the Rust reference round-trips.
+#define QK_ROCMFPX 32
+typedef struct {
+    uint8_t qs[16]; // nibbles: lo=values 0..15, hi=values 16..31
+    uint8_t d[2];   // UE4M3 scales (per 16)
+} block_rocmfp4;    // 18 B
+typedef struct {
+    uint8_t qs[16]; // nibbles: lo=x[j], hi=x[j+16]
+    uint8_t d;      // UE4M3 scale
+} block_rocmfp4_fast; // 17 B
+typedef struct {
+    uint8_t qs[24]; // signed 6-bit codes, 4 codes/3 bytes
+    uint8_t d[2];   // UE4M3 scales (per 16)
+} block_rocmfp6;    // 26 B
+typedef struct {
+    int8_t  qs[32]; // int8 values
+    uint8_t d;      // UE4M3 scale
+} block_rocmfp8;    // 33 B
+typedef struct {
+    uint8_t qs[12]; // 3-bit codes, 8 codes/3 bytes
+    uint8_t d[2];   // UE4M3 scales (per 16)
+} block_rocmfp3;    // 14 B
+typedef struct {
+    uint8_t qs[8];  // 2-bit codes, 4 codes/byte
+    uint8_t d[2];   // UE4M3 scales (per 16)
+} block_rocmfp2;    // 10 B
+static_assert(sizeof(block_rocmfp4)      == 18, "wrong rocmfp4 block size");
+static_assert(sizeof(block_rocmfp4_fast) == 17, "wrong rocmfp4_fast block size");
+static_assert(sizeof(block_rocmfp6)      == 26, "wrong rocmfp6 block size");
+static_assert(sizeof(block_rocmfp8)      == 33, "wrong rocmfp8 block size");
+static_assert(sizeof(block_rocmfp3)      == 14, "wrong rocmfp3 block size");
+static_assert(sizeof(block_rocmfp2)      == 10, "wrong rocmfp2 block size");
+
+// Edge0 (private): TurboQuant KV blocks. One 128-value block = an f16 L2 norm plus the
+// 32-value sub-block codes; the FWHT rotation is applied over the whole 128 values. The
+// norm is applied after the inverse FWHT on decode.
+#define QK_TURBO 128
+typedef struct {
+    ggml_half norm;   // L2 norm of the 128-value chunk
+    uint8_t qs[48];   // 128 x 3-bit indices (32 per sub-block, 12 bytes each)
+} block_turbo3;       // 50 B
+typedef struct {
+    ggml_half norm;
+    uint8_t qs[64];   // 128 x 4-bit indices (16 bytes per 32)
+} block_turbo4;       // 66 B
+static_assert(sizeof(block_turbo3) == sizeof(ggml_half) + 48, "wrong turbo3 block size");
+static_assert(sizeof(block_turbo4) == sizeof(ggml_half) + 64, "wrong turbo4 block size");
+
 #define QK_NVFP4 64
 #define QK_NVFP4_SUB 16  // sub-block size for per-group scales
 typedef struct {
@@ -1128,6 +1177,12 @@ GGML_TABLE_BEGIN(int8_t, kvalues_fp4, 16)
 GGML_TABLE_END()
 #define kvalues_mxfp4 kvalues_fp4
 
+// Edge0: ROCmFP4 nibble codebook (magnitude {0,1,2,3,4,6,8,10} + sign). Differs from
+// MXFP4 at index 7 (10 vs 12), so it needs its own table.
+GGML_TABLE_BEGIN(int8_t, kvalues_rocmfp4, 16)
+    0, 1, 2, 3, 4, 6, 8, 10, 0, -1, -2, -3, -4, -6, -8, -10,
+GGML_TABLE_END()
+
 #define NGRID_IQ1S 2048
 #define IQ1S_DELTA 0.125f
 #define IQ1M_DELTA 0.125f
