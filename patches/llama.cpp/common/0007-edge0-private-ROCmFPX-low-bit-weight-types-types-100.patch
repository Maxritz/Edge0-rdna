+        ggml_rocmfpx_fp3_unpack8(&x[i].qs[0], &codes[0]);  ggml_rocmfpx_fp3_unpack8(&x[i].qs[3], &codes[8]);
+        ggml_rocmfpx_fp3_unpack8(&x[i].qs[6], &codes[16]); ggml_rocmfpx_fp3_unpack8(&x[i].qs[9], &codes[24]);
+        const float d0 = ggml_ue4m3_to_fp32(x[i].d[0]);
+        const float d1 = ggml_ue4m3_to_fp32(x[i].d[1]);
+        for (int j = 0; j < 16; ++j) {
+            y[i*qk + j     ] = ggml_rocmfpx_fp3_code(codes[j])      * d0;
+            y[i*qk + j + 16] = ggml_rocmfpx_fp3_code(codes[j + 16]) * d1;
+        }
+    }
