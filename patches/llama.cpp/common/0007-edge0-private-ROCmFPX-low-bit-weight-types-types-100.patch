+// Edge0 (private): generic vec_dot for the ROCmFPX weight formats against q8_0. The
+// activation is quantized to q8_0 and each weight block is dequantized inline.
+#define GGML_ROCMFPX_VEC_DOT(fn, blktype, dequant_fn)                                                        \
+    static void fn(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx,      \
+                   const void * GGML_RESTRICT vy, size_t by, int nrc) {                                      \
+        assert(nrc == 1);                                                                                    \
+        UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);                                                     \
+        assert(n % QK_ROCMFPX == 0);                                                                         \
+        const blktype * GGML_RESTRICT x = vx;                                                                \
+        const block_q8_0 * GGML_RESTRICT y = vy;                                                             \
+        const int nb = n / QK_ROCMFPX;                                                                       \
+        float sumf = 0;                                                                                      \
+        float vw[QK_ROCMFPX];                                                                                \
+        for (int ib = 0; ib < nb; ++ib) {                                                                    \
+            dequant_fn(&x[ib], vw, QK_ROCMFPX);                                                              \
+            const int8_t * GGML_RESTRICT yq = y[ib].qs;                                                      \
+            float blk = 0;                                                                                   \
+            for (int j = 0; j < QK_ROCMFPX; ++j) { blk += (float) yq[j] * vw[j]; }                           \
+            sumf += blk * GGML_CPU_FP16_TO_FP32(y[ib].d);                                                    \
+        }                                                                                                    \
+        *s = sumf;                                                                                           \
+    }
+
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp4_q8_0,      block_rocmfp4,      dequantize_row_rocmfp4)
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp4_fast_q8_0, block_rocmfp4_fast, dequantize_row_rocmfp4_fast)
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp6_q8_0,      block_rocmfp6,      dequantize_row_rocmfp6)
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp8_q8_0,      block_rocmfp8,      dequantize_row_rocmfp8)
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp3_q8_0,      block_rocmfp3,      dequantize_row_rocmfp3)
+GGML_ROCMFPX_VEC_DOT(ggml_vec_dot_rocmfp2_q8_0,      block_rocmfp2,      dequantize_row_rocmfp2)
+
