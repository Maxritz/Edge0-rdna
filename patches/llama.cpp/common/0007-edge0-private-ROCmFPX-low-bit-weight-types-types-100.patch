+static uint8_t ggml_rocmfpx_fp4_quant_code(float x, float inv) {
+    const float v = roundf(x * inv);
+    uint8_t best = 0;
+    float bd = fabsf(ggml_rocmfpx_fp4_code(0) - v);
+    for (int q = 1; q < 16; ++q) {
+        const float d = fabsf(ggml_rocmfpx_fp4_code((uint8_t) q) - v);
+        if (d < bd) { bd = d; best = (uint8_t) q; }
+    }
+    return best;
+}
+
+static uint8_t ggml_rocmfpx_fp3_quant_code(float x, float inv) {
+    const float a = fabsf(x * inv);
+    const int mag = a <= 0.5f ? 0 : a <= 1.5f ? 1 : a <= 3.0f ? 2 : 3;
+    if (mag == 0) { return 0; }
+    return (uint8_t)((x < 0.0f ? 4 : 0) | mag);
+}
+
+static uint8_t ggml_rocmfpx_fp6_quant_code(float x, float inv) {
+    int q = (int) lroundf(x * inv);
+    if (q > 31) { q = 31; } else if (q < -32) { q = -32; }
+    if (q == 0) { return 0; }
+    if (q < 0)  { return (uint8_t)(32u | ((uint8_t)(-q) & 31)); }
+    return (uint8_t) q;
+}
