+        const int packed = (rocmfp3_val(bits & 7) & 0xFF)
+                         | ((rocmfp3_val((bits >> 3) & 7) & 0xFF) << 8)
+                         | ((rocmfp3_val((bits >> 6) & 7) & 0xFF) << 16)
+                         | ((rocmfp3_val((bits >> 9) & 7) & 0xFF) << 24);
