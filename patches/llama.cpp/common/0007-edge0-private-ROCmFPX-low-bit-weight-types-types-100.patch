+// Edge0 (private): opt-in per-op device timing (EDGE0_CUDA_OP_TIMING=1). Records a CUDA
+// event pair around every graph node, aggregates device time by op name, and prints the
+// sherlock-style component table. CUDA graphs are disabled while this is on.
+#include <unordered_map>
+#include <vector>
+#include <string>
+#include <algorithm>
+#include <cstdio>
+
+namespace {
+struct edge0_op_timer {
+    bool enabled = false;
+    bool ready   = false;
+    static constexpr int MAX_SPANS = 1024;
+    std::vector<void *> ev;                      // 2*MAX_SPANS events
+    std::vector<int>    span_ev;                 // span index -> base
+    std::vector<std::string> span_name;          // span index -> label
+    std::unordered_map<std::string, double> agg_ms;
+    std::unordered_map<std::string, long long> agg_n;
+    int calls = 0;
+
+    void init() {
+        if (ready) return;
+        ready = true;
+        enabled = getenv("EDGE0_CUDA_OP_TIMING") != nullptr && atoi(getenv("EDGE0_CUDA_OP_TIMING"));
+        if (!enabled) return;
+        // Per-op events conflict with CUDA-graph capture and the MoE fusion path it
+        // enables; disable fusion while profiling so the engine stays stable.
+#ifdef _WIN32
+        _putenv_s("GGML_CUDA_DISABLE_FUSION", "1");
+#else
+        setenv("GGML_CUDA_DISABLE_FUSION", "1", 1);
+#endif
+        ev.resize(2 * MAX_SPANS, nullptr);
+        for (auto & e : ev) {
+            cudaEvent_t h = nullptr;
+            if (cudaEventCreateWithFlags(&h, 0) != cudaSuccess) { // 0 = timing enabled (needed for elapsed time)
+                enabled = false; // no event handles available; stay silent rather than crash
+                return;
+            }
+            e = (void *) h;
+        }
+        span_ev.reserve(MAX_SPANS);
+        span_name.reserve(MAX_SPANS);
+    }
+
+    int start(cudaStream_t s) {
+        if (span_ev.size() >= (size_t) MAX_SPANS) return -1;
+        const int i = (int) span_ev.size();
+        span_ev.push_back(i);
+        span_name.push_back("");
+        cudaEventRecord((cudaEvent_t) ev[2 * i], s);
+        return i;
+    }
+    void stop(int i, const char * name, cudaStream_t s) {
+        if (i < 0) return;
+        cudaEventRecord((cudaEvent_t) ev[2 * i + 1], s);
+        span_name[i] = name ? name : "?";
+    }
+    void finish(cudaStream_t s) {
+        cudaStreamSynchronize(s);
+        for (size_t i = 0; i < span_ev.size(); ++i) {
+            float ms = 0.0f;
+            hipEventElapsedTime(&ms, (hipEvent_t) ev[2 * i], (hipEvent_t) ev[2 * i + 1]);
+            agg_ms[span_name[i]] += ms;
+            agg_n[span_name[i]] += 1;
+        }
+        span_ev.clear();
+        span_name.clear();
+        calls++;
+        if (calls % 8 == 0 || calls == 1) print();
+    }
+    void print() {
+        double total = 0;
+        for (auto & kv : agg_ms) total += kv.second;
+        std::vector<std::pair<std::string, double>> rows(agg_ms.begin(), agg_ms.end());
+        std::sort(rows.begin(), rows.end(), [](const auto & a, const auto & b) { return a.second > b.second; });
+        fprintf(stderr, "\n[edge0-op-timing] graph calls=%d  total_dev=%.1f ms\n", calls, total);
+        fprintf(stderr, "  %-22s %8s %12s %10s\n", "component", "ops", "dev ms", "%dev");
+        for (auto & r : rows) {
+            fprintf(stderr, "  %-22s %8lld %12.2f %9.1f%%\n", r.first.c_str(), agg_n[r.first], r.second,
+                    total > 0 ? 100.0 * r.second / total : 0.0);
+        }
+    }
+};
+static edge0_op_timer g_op_timer;
+} // namespace
