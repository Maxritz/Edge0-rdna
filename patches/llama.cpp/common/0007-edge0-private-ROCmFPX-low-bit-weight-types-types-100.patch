+// Edge0: ROCmFP3 (block_rocmfp3, 14 B, 2 UE4M3 scales, codebook {0,1,2,4}+sign).
+// 32 values at 3 bits, LSB-first (value i at bit i*3). qi=8, so each call covers 4
+// values in natural order, aligned 1:1 to one q8 int (no MXFP4-style reorder).
+__device__ __forceinline__ int rocmfp3_get4(const uint8_t * qs, const int c) {
+    const int bit = c * 12;                      // group c covers 4 values * 3 bits
+    const int by = bit >> 3;
+    const uint32_t w = (uint32_t) qs[by] | ((uint32_t) qs[by + 1] << 8);
+    return (int)((w >> (bit & 7)) & 0xFFF);      // 4 codes * 3 bits = 12 bits
+}
