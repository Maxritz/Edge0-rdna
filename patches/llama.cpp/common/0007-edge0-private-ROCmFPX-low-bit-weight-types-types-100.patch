+void dequantize_row_rocmfp4(const block_rocmfp4 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_ROCMFPX;
+    assert(k % qk == 0);
+    const int nb = k / qk;
+    for (int i = 0; i < nb; i++) {
+        const float d0 = ggml_ue4m3_to_fp32(x[i].d[0]);
+        const float d1 = ggml_ue4m3_to_fp32(x[i].d[1]);
+        for (int j = 0; j < 16; ++j) {
+            y[i*qk + j     ] = ggml_rocmfpx_fp4_code(x[i].qs[j] & 0x0F) * d0;
+            y[i*qk + j + 16] = ggml_rocmfpx_fp4_code(x[i].qs[j] >>   4) * d1;
+        }
+    }
+}
